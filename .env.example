# URL of the Supabase project used by THIS Vercel environment.
NEXT_PUBLIC_SUPABASE_URL=
# Set ONE public key (never the service-role/secret key):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set this to the same HTTPS origin as your deployed website; no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.example
# Alternative name retained for compatibility with email-renderer settings:
# NEXT_PUBLIC_APP_URL=https://your-deployed-domain.example
# Keep Resend delivery disabled until Auth Hook validation and sender verification.
ENABLE_PLATFORM_EMAIL_DELIVERY=false
# RESEND_API_KEY= (server-only in Vercel secrets)
# RESEND_FROM_EMAIL=no-reply@your-verified-domain.example

# Resend webhook signature verification (server-only)
# RESEND_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY= (only for signed Resend delivery webhook, server-only)

# Phase 030D (server only). The URL is called by an independently configured scheduler.
ENABLE_AUTOMATION_RUNS=false
ENABLE_AUTOMATION_EMAIL_DELIVERY=false
# AUTOMATION_RUNNER_SECRET= (generate 32+ random characters; never use NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY= (server only; already needed for webhook processing)

# Phase 030D: controlled scheduled reminders. KEEP BOTH DISABLED UNTIL STAGING TESTS.
ENABLE_AUTOMATION_RUNS=false
ENABLE_AUTOMATION_EMAIL_DELIVERY=false
# AUTOMATION_RUNNER_SECRET= (server-only, random 32+ characters)
# SUPABASE_SERVICE_ROLE_KEY= (server-only, must never be NEXT_PUBLIC_)
